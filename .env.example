# Palabra API Key — create one at https://platform.palabra.ai/api-keys
PALABRA_API_KEY=plbr_...
# Region: eu (default) or us
# PALABRA_REGION=eu

# vapi bridge
# VAPI_SECRET=change-me                # enforced as the x-vapi-secret header when set
# PALABRA_STT_LANGUAGE=en              # default: server-side auto-detection
# VAPI_SEND_PARTIALS=false
# PALABRA_TTS_LANGUAGE=en
# PALABRA_VOICE_ID=default_low

# jambonz bridge
# JAMBONZ_API_KEY=change-me            # the API key you enter for the custom vendor in jambonz
# PALABRA_TTS_SAMPLE_RATE=24000

# wyoming server
# PALABRA_LANGUAGE=en                  # TTS language fallback
# LOG_LEVEL=INFO
